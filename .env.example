APP_NAME=DeployFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_RETENTION_DAYS=30

# Database (requires the pdo_pgsql extension)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=deployflow
DB_USERNAME=deployflow_app
DB_PASSWORD=deployflow

# Redis (requires the redis extension)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=deployflow
REDIS_PORT=6379
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1
REDIS_DB_LOCKS=2
REDIS_DB_NONCE=3

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
HORIZON_PREFIX=deployflow_horizon

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@deployflow.local"
MAIL_FROM_NAME="${APP_NAME}"

# Log storage (local MinIO defaults; see docs/CONFIGURATION.md)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=deployflow
AWS_SECRET_ACCESS_KEY=deployflow
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=deployflow-logs
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# GitHub App (docs/CONFIGURATION.md §5)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Registry (docs/CONFIGURATION.md §6)
REGISTRY_DRIVER=local
REGISTRY_HOST=registry.local:5000
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_REPOSITORY_PREFIX=deployflow
REGISTRY_ALLOWED_HOSTS=registry.local:5000

# Deployment target (docs/CONFIGURATION.md §8)
DEPLOY_BASE_DOMAIN=apps.deployflow.test
TRAEFIK_DYNAMIC_PATH=/traefik/dynamic
TRAEFIK_ROUTER_ENTRYPOINT=websecure

# Worker/bootstrap (docs/CONFIGURATION.md §9)
WORKER_BOOTSTRAP_TOKEN=
WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=30
WORKER_OFFLINE_AFTER_SECONDS=60
BUILD_TIMEOUT_SECONDS=1200
DEPLOY_TIMEOUT_SECONDS=120
HEALTH_INTERVAL_SECONDS=5
HEALTH_TIMEOUT_SECONDS=2
HEALTH_RETRIES=12

# Platform operations (docs/CONFIGURATION.md §10)
PLATFORM_ADMIN_EMAILS=
FORCE_HTTPS=false
METRICS_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
